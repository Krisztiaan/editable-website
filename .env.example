DB_PATH=./data/db.sqlite3
ADMIN_PASSWORD=xxxxxxxxxxxxxx
ORIGIN=https://myapp.fly.dev

# OpenTelemetry (optional but recommended for tracing)
# Service name used in traces
OTEL_SERVICE_NAME=editable-website
# Example Jaeger all-in-one via OTLP/gRPC (proto exporter uses envs automatically)
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4317
# Or OTLP/http if you switch exporter packages to http
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your-token
